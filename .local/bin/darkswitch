#!/bin/bash

general_var(){
	sleep 0.5 # Sleep first to wait for system to update
	
	# Setting up variable for future use
	# Gathering current system settings
	COLOR=$(gsettings get org.gnome.desktop.interface accent-color | sed -e 's/"//g' -e "s/'//g" -e 's/ //g')
	CURRENT_THEME_QT="libadwaita-kde-$MODE-$COLOR"
	CURRENT_THEME_GTK3=$(gsettings get org.gnome.desktop.interface gtk-theme)
	THEME_PATH_QT="/usr/share/color-schemes/"
	ICON_THEME_QT="breeze"
	# Store previous settings into var
	PREV_THEME_QT5=$(cat $HOME/.config/qt5ct/qt5ct.conf | grep -o -P '(?<=color_scheme_path=).*')
	PREV_THEME_QT6=$(cat $HOME/.config/qt6ct/qt6ct.conf | grep -o -P '(?<=color_scheme_path=).*')
	PREV_ICON_THEME_QT5=$(cat $HOME/.config/qt5ct/qt5ct.conf | grep -o -P '(?<=icon_theme=).*')
	PREV_ICON_THEME_QT6=$(cat $HOME/.config/qt6ct/qt6ct.conf | grep -o -P '(?<=icon_theme=).*')
	PREV_MODE_GTK3=$(cat $HOME/.config/gtk-3.0/settings.ini | grep -o -P '(?<=gtk-application-prefer-dark-theme=).*')
	PREV_THEME_GTK3=$(cat $HOME/.config/gtk-3.0/settings.ini | grep -o -P '(?<=gtk-theme-name=).*')
	# Store previous Krita theme settings
	PREV_THEME_KRITA=$(cat $HOME/.config/kritarc | grep -o -P '(?<=Theme=).*')
	# Store previous Kdenlive theme settings
	PREV_THEME_KDL=$(cat $HOME/.config/kdenliverc | grep -o -P '(?<=ColorScheme=).*')
	PREV_THEME_KDL_PATH=$(cat $HOME/.config/kdenliverc | grep -o -P '(?<=ColorSchemePath=).*')
	# Ducstation current settings
	PREV_THEME_DSTATION=$(cat $HOME/.local/share/duckstation/settings.ini | grep -o -P '(?<=Theme = ).*')
}

light() {
	MODE="light" # Light mode variable

	general_var # Get those var

	# Blur My Shell settings
	BMS_PIPELINE="pipeline_78969828680812"
	BMS_SIGMA="100"
	BMS_BRIGHTNESS="1"
	BMS_STYLE="2"
	BMS_STYLE_PANEL="1"
	BMS_BACKGROUND_COLOR="#000000" # This one went unused for light mode.
	BMS_BACKGROUND_OPACITY="0.25"

	CURRENT_MODE_GTK3="0" # GTK3 light mode
	CURRENT_ICON_THEME_QT=$ICON_THEME_QT # Icon theme for qt apps

	DSTATION_THEME="fusion" # Duckstation

	set_theme # Finally set the theme
}

dark() {
	MODE="dark" # Light mode variable

	general_var # Get those var

	# Blur My Shell settings
	BMS_PIPELINE="pipeline_default"
	BMS_SIGMA="30"
	BMS_BRIGHTNESS="0.5"
	BMS_STYLE="2"
	BMS_STYLE_PANEL="0"
	BMS_BACKGROUND_COLOR="#000000" # This one went used for dark mode.
	BMS_BACKGROUND_OPACITY="0.5"

	CURRENT_MODE_GTK3="1" # GTK3 dark mode
	CURRENT_ICON_THEME_QT=$ICON_THEME_QT"-"$MODE # Icon theme for qt apps
	
	DSTATION_THEME="darkfusion" # Duckstation

	set_theme # Finally set the theme
}

set_theme(){
	sed -i -e '0,/'"$PREV_THEME_KRITA"'/{s/'"$PREV_THEME_KRITA"'/'"$CURRENT_THEME_QT"'/g}' $HOME/.config/kritarc; # Krita stuff

	# Kdenlive stuff
	sed -i -e '0,/'"$PREV_THEME_KDL"'/{s/'"$PREV_THEME_KDL"'/'"$CURRENT_THEME_QT"'/g}' $HOME/.config/kdenliverc;
	sed -i -e '0,/'"$PREV_THEME_KDL_PATH"'/{s/'"$PREV_THEME_KDL_PATH"'/'"$CURRENT_THEME_QT"'.colors/g}' $HOME/.config/kdenliverc;

	# Qt apps
	kvantummanager --set $CURRENT_THEME_QT > /dev/null 2>&1;
	sudo kvantummanager --set $CURRENT_THEME_QT > /dev/null 2>&1; 
	sed -i -e '0,\@'"$PREV_THEME_QT6"'@{s@'"$PREV_THEME_QT6"'@'"$THEME_PATH_QT"''"$CURRENT_THEME_QT"'.colors@g}' $HOME/.config/qt6ct/qt6ct.conf;
	sed -i -e '0,\@'"$PREV_THEME_QT5"'@{s@'"$PREV_THEME_QT5"'@'"$THEME_PATH_QT"''"$CURRENT_THEME_QT"'.colors@g}' $HOME/.config/qt5ct/qt5ct.conf;
	# Set icon theme  for qt apps
	sed -i -e '0,/'"$PREV_ICON_THEME_QT6"'/{s/'"$PREV_ICON_THEME_QT6"'/'"$CURRENT_ICON_THEME_QT"'/g}' $HOME/.config/qt6ct/qt6ct.conf;
	sed -i -e '0,/'"$PREV_ICON_THEME_QT5"'/{s/'"$PREV_ICON_THEME_QT5"'/'"$CURRENT_ICON_THEME_QT"'/g}' $HOME/.config/qt5ct/qt5ct.conf;
	
	#GTK3
	sed -i -e '0,/'"$PREV_MODE_GTK3"'/{s/'"$PREV_MODE_GTK3"'/'"$CURRENT_MODE_GTK3"'/g}' $HOME/.config/gtk-3.0/settings.ini;
	sed -i -e '0,/'"$PREV_THEME_GTK3"'/{s/'"$PREV_THEME_GTK3"'/'"$CURRENT_THEME_GTK3"'/g}' $HOME/.config/gtk-3.0/settings.ini;
	
	sed -i -e '0,/'"$PREV_THEME_DSTATION"'/{s/'"$PREV_THEME_DSTATION"'/'"$DSTATION_THEME"'/g}' $HOME/.local/share/duckstation/settings.ini; # Duckstation appimage stuff

	# Extensions settings
	gsettings set org.gnome.shell.extensions.blur-my-shell.overview pipeline $BMS_PIPELINE;
	gsettings set org.gnome.shell.extensions.blur-my-shell.dash-to-dock sigma $BMS_SIGMA;
	gsettings set org.gnome.shell.extensions.blur-my-shell.panel brightness $BMS_BRIGHTNESS;
	gsettings set org.gnome.shell.extensions.blur-my-shell.panel sigma $BMS_SIGMA;
	gsettings set org.gnome.shell.extensions.blur-my-shell.panel style-panel $BMS_STYLE_PANEL;
	gsettings set org.gnome.shell.extensions.blur-my-shell.overview style-components $BMS_STYLE;
	gsettings set org.gnome.shell.extensions.blur-my-shell.appfolder style-dialogs $BMS_STYLE;
	gsettings set org.gnome.shell.extensions.blur-my-shell.screenshot pipeline $BMS_PIPELINE;
	gsettings set org.gnome.shell.extensions.blur-my-shell.coverflow-alt-tab pipeline $BMS_PIPELINE;
	gsettings set org.gnome.shell.extensions.dash-to-dock background-opacity $BMS_BACKGROUND_OPACITY;

	if [[ "$MODE" = "dark" ]]; then
		gsettings set org.gnome.shell.extensions.dash-to-dock background-color $BMS_BACKGROUND_COLOR; # Extensions settings
		sudo waydroid shell cmd uimode night yes # Waydroid settings
	else
		gsettings reset org.gnome.shell.extensions.dash-to-dock background-color; # Extensions settings
		sudo waydroid shell cmd uimode night no # Waydroid settings
	fi
}

# More safety, by turning some bugs into errors.
set -o errexit -o pipefail -o noclobber -o nounset

# ignore errexit with `&& true`
getopt --test > /dev/null && true
if [[ $? -ne 4 ]]; then
    echo 'I’m sorry, `getopt --test` failed in this environment.'
    exit 1
fi

LONGOPTS=dark,light
OPTIONS=dl

# -temporarily store output to be able to check for errors
# -activate quoting/enhanced mode (e.g. by writing out “--options”)
# -pass arguments only via   -- "$@"   to separate them correctly
# -if getopt fails, it complains itself to stderr
PARSED=$(getopt --options=$OPTIONS --longoptions=$LONGOPTS --name "$0" -- "$@") || exit 2
# read getopt’s output this way to handle the quoting right:
eval set -- "$PARSED"

d=n l=n
# now enjoy the options in order and nicely split until we see --
while true; do
    case "$1" in
        -d|--dark)
            d=y
            dark
            shift
            break
            ;;
			-l|--light)
			l=y
            light
            shift
            break
            ;;
        --)
            shift
            break
            ;;
        *)
            echo "Programming error"
            exit 3
            ;;
    esac
done

# handle non-option arguments
if [[ $# -ne 1 ]]; then
    echo "$0: A single input file is required."
    exit 4
fi

# echo "all: $A, kernel: $k, gnome-shell: $g"
