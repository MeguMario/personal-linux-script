#!/bin/bash
ppd_state=$(tuned-adm active | grep -o -P '(?<=Current active profile: ).*')
ppd_current_state=$(cat /tmp/ppd_current_state_script)
ext_state=$(gnome-extensions info gradienttopbar@pshow.org | grep -o -P '(?<=Enabled: ).*')
CONF_FILE="/tmp/ppd_current_state_script"

off(){
		  gsettings set org.gnome.shell.extensions.blur-my-shell.appfolder blur false
		  gsettings set org.gnome.shell.extensions.blur-my-shell.applications blur false
		  gsettings set org.gnome.shell.extensions.blur-my-shell.coverflow-alt-tab blur false
		  gsettings set org.gnome.shell.extensions.blur-my-shell.dash-to-dock blur false
		  gsettings set org.gnome.shell.extensions.blur-my-shell.overview blur false
		  # gsettings set org.gnome.shell.extensions.blur-my-shell.lockscreen blur false
		  gsettings set org.gnome.shell.extensions.blur-my-shell.panel blur false
		  gsettings set org.gnome.shell.extensions.blur-my-shell.screenshot blur false
		  gsettings set org.gnome.shell.extensions.blur-my-shell.window-list blur false
		  gsettings set org.gnome.shell.extensions.quick-settings-tweaks menu-animation-background-blur-radius 0
		  #if [[ $ext_state = "No" ]]; then
		  #		gnome-extensions enable gradienttopbar@pshow.org
		  	#fi
		  cat /tmp/ppd_current_state_script
}

on(){
		  gsettings set org.gnome.shell.extensions.blur-my-shell.appfolder blur true
		  gsettings set org.gnome.shell.extensions.blur-my-shell.applications blur true
		  gsettings set org.gnome.shell.extensions.blur-my-shell.coverflow-alt-tab blur true
		  gsettings set org.gnome.shell.extensions.blur-my-shell.dash-to-dock blur true
		  gsettings set org.gnome.shell.extensions.blur-my-shell.overview blur true
		  # gsettings set org.gnome.shell.extensions.blur-my-shell.lockscreen blur true
		  gsettings set org.gnome.shell.extensions.blur-my-shell.panel blur true
		  gsettings set org.gnome.shell.extensions.blur-my-shell.screenshot blur true
		  gsettings set org.gnome.shell.extensions.blur-my-shell.window-list blur true
		  gsettings reset org.gnome.shell.extensions.quick-settings-tweaks menu-animation-background-blur-radius
		  #if [[ $ext_state = "Yes" ]]; then
		 	# 	gnome-extensions disable gradienttopbar@pshow.org
		  #fi
		  cat /tmp/ppd_current_state_script
}

if [[ $ppd_state != $ppd_current_state ]]; then
	echo $ppd_state > "$CONF_FILE"
	case $ppd_state in
		powersave | performance)
			off
		  ;;
		balanced-battery | balanced)
			on
		  ;;
		*)
		  echo -n "unknown"
		  ;;
	esac
fi
